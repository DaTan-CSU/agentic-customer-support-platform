# Copy this to .env at the project root.
# The text model pair is required for chat; optional services can stay empty.

# Aliyun Bailian OpenAI-compatible text model gateway.
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Use a model available in your Bailian account, for example qwen-plus.
# OPENAI_MODEL=qwen-plus

# Optional legacy key-file compatibility. Leave unset for normal .env setups.
# KEY_FILE_PATH=C:/path/to/API key.txt

# Aliyun Bailian (image OCR + embeddings). Read by python-backend/ecommerce/vision.py.
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# Tencent Cloud ASR (push-to-talk speech to text). Optional.
# TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
# TENCENTCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
